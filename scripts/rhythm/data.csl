Chart_Note :: struct {
    @ao_serialize beat: float;
    @ao_serialize lane: int;
    @ao_serialize side: int;
    @ao_serialize hold: float;
}
Stage_Object :: struct {
    @ao_serialize kind: int;
    @ao_serialize x: float;
    @ao_serialize y: float;
    @ao_serialize size: float;
    @ao_serialize rotation: float;
    @ao_serialize layer: int;
}
Song_Event :: struct {
    @ao_serialize beat: float;
    @ao_serialize kind: int;
    @ao_serialize strength: float;
    @ao_serialize duration: float;
    @ao_serialize text: string;
}
Song_Mod :: class {
    @ao_serialize version: int = 1;
    @ao_serialize id: string;
    @ao_serialize name: string = "My Encore";
    @ao_serialize artist: string = "Independent Artist";
    @ao_serialize bpm: float = 120;
    @ao_serialize length_beats: int = 192;
    @ao_serialize difficulty: int = 1;
    @ao_serialize audio: int;
    @ao_serialize stage: int;
    @ao_serialize character_name: string = "Nova";
    @ao_serialize player_color: int = 2;
    @ao_serialize rival_color: int = 12;
    @ao_serialize pitch: float = 1;
    @ao_serialize voice_type: int;
    @ao_serialize voice_tone: int = 1;
    @ao_serialize voice_style: int;
    @ao_serialize voice_effect: int;
    @ao_serialize rival_voice_type: int = 1;
    @ao_serialize rival_voice_tone: int = 1;
    @ao_serialize rival_voice_style: int = 1;
    @ao_serialize rival_voice_effect: int;
    @ao_serialize rival_pitch: float = 1;
    @ao_serialize animation_speed: float = 1;
    @ao_serialize mic_size: float = 0.25;
    @ao_serialize mic_x: float = 0.02;
    @ao_serialize mic_y: float = 0.05;
    @ao_serialize mic_style: int;
    @ao_serialize note_skin: int;
    @ao_serialize theme: int;
    @ao_serialize glow: float = 1;
    @ao_serialize trails: bool = true;
    @ao_serialize particles: bool = true;
    @ao_serialize health_y: float;
    @ao_serialize hud_x: float;
    @ao_serialize judgement_names: [5]string = {"SICK!", "GOOD!", "BAD!", "DANG!", "MISS!"};
    @ao_serialize dialogue: string;
    @ao_serialize notes: [..]Chart_Note;
    @ao_serialize objects: [..]Stage_Object;
    @ao_serialize events: [..]Song_Event;
}
Mod_Library :: class { @ao_serialize mods: [..]Song_Mod; }
Published_Mod :: class {
    @ao_serialize code: string;
    @ao_serialize author_id: string;
    @ao_serialize author: string;
    @ao_serialize mod: Song_Mod;
}
Rhythm_Note :: class {
    voice_clip: string;
    voice_scheduled: bool;
    voice_segments: [..]u64;
    vocal_midi: int;
    voice_attack: u64;
    voice_loop: u64;
    rival_voice_attack: u64;
    rival_voice_loop: u64;
    time: float;
    hold: float;
    lane: int;
    side: int;
    state: int;
    rating: int;
    bot_offset: float;
    hold_release: float;
    interp: Position_Interpolation_Helper;
}
song_names: [12]string = {"Soundcheck", "Moonline", "Skyline Swing", "Midnight Relay", "Velvet Voltage", "Curtain Call", "Double Take", "Afterparty", "Star Signal", "Orbit Break", "Supernova", "Encore"};
song_bpms: [12]float : {100,112,124,132,138,146,142,118,127,152,158,164};
song_beats: [12]int = {160,192,192,224,192,192,224,224,224,256,256,256};
week_names: [5]string : {"Neon First Steps","Midnight Motion","Voltage Clash","Prism Paradox","Stellar Finale"};
week_first: [5]int : {0,2,4,7,9};
week_last: [5]int : {1,3,6,8,11};
week_stages: [5]int : {0,0,1,1,2};
week_rival_colors: [5]int : {12,5,8,14,3};
song_week :: proc(song: int) -> int {
    for i: 0..<5 { if song<=week_last[i] { return i; } }
    return 4;
}
song_stage :: proc(song: int) -> int { return week_stages[song_week(clamp(song,0,11))]; }
arrow_paths: [4]string = {"UI/arrow_left.png", "UI/arrow_down.png", "UI/arrow_up.png", "UI/arrow_right.png"};
arrow_colors: [4]v4 = {{0.85,0.32,1,1},{0.22,0.85,1,1},{0.38,1,0.55,1},{1,0.35,0.54,1}};
rating_colors: [5]v4 = {{0.4,1,0.95,1},{0.45,1,0.6,1},{1,0.85,0.35,1},{1,0.5,0.15,1},{1,0.18,0.28,1}};
rating_names: [5]string = {"SICK!", "GOOD!", "BAD!", "DANG!", "MISS!"};
stage_names: [4]string = {"Moonline Rooftop", "Velvet Voltage", "Orbital Encore", "Creator Soundstage"};
editor_tabs: [10]string = {"Song", "Chart", "Character", "Stage", "Effects", "UI & Notes", "Events", "Cutscene", "Mod Manager", "Publish"};
achievement_names: [18]string = {"Warmup", "First Ten", "Clean Phrase", "Quarter Century", "Fifty Flow", "Hundred Club", "Two Hundred", "No Misses", "Sick Streak", "Night Owl", "Curtain Star", "Orbit Ace", "Bot Breaker", "Perfect Duel", "Chartsmith", "Stagehand", "Voice Maker", "Published Artist"};
difficulty_name :: proc(d: int) -> string { return ([3]string){"Easy", "Normal", "Hard"}[clamp(d,0,2)]; }
bot_name :: proc(d: int) -> string { return ([4]string){"Easy", "Normal", "Hard", "Perfect"}[clamp(d,0,3)]; }
find_player :: proc(id: string) -> Player {
    for p: component_iterator(Player) { if p.get_user_id() == id { return p; } }
    return null;
}
accuracy :: proc(p: Player) -> float { return p.judged > 0 ? p.weight / p.judged.(float) * 100 : 100; }
bot_accuracy :: proc(p: Player) -> float { return p.bot_judged > 0 ? p.bot_weight / p.bot_judged.(float) * 100 : 100; }
music_path :: proc(song: int) -> string { return `music/track_{clamp(song,0,11)}.wav`; }
clone_mod :: proc(m: Song_Mod) -> Song_Mod {
    c: Song_Mod; encoded := JSON.serialize(ref m);
    if !JSON.try_deserialize(encoded, ref c) { return new_song_mod(); }
    return c;
}
new_song_mod :: proc() -> Song_Mod {
    m := new(Song_Mod);
    m.length_beats=64; // A complete short starter chart, not a minute of dead air.
    for b: 8..<64 { m.notes.append(.{beat=b.(float), lane=b % 4, side=((b / 8) % 3 == 0) ? 0 : 1}); }
    return m;
}
unlock_achievement :: proc(p: Player, index: int) {
    if p.perf_active { return; } // Stress fixtures must never unlock saved rewards.
    flag := 1 << index;
    if (p.achievements & flag) != 0 { return; }
    p.achievements |= flag; p.unlocked_name = achievement_names[index]; p.unlocked_time = get_time();
    Save.set_int(p, "encore_achievements", p.achievements);
    rhythm_sound(p, "sfx/unlock.wav", 0.6);
}
rhythm_sound :: proc(p: Player, path: string, volume: float = 0.5, speed: float = 1) {
    desc := SFX.default_sfx_desc(); desc.specific_to_player = p; desc.entity_to_follow = p.entity.id;
    desc.volume = volume * p.volume; desc.speed = speed; desc.speed_perturb = 0;
    SFX.play(get_asset(SFX_Asset, path), desc);
}
int_text :: proc(value: int) -> string { return `{value}`; }
float_text :: proc(value: float,decimals: int = 1) -> string { return `{format_float(value,decimals=decimals)}`; }
