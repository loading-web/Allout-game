append_stock_score :: proc(p: Player) {
    switch p.song {
        case 0: { for n: stock_score_0 { append_score_note(p,n); } }
        case 1: { for n: stock_score_1 { append_score_note(p,n); } }
        case 2: { for n: stock_score_2 { append_score_note(p,n); } }
        case 3: { for n: stock_score_3 { append_score_note(p,n); } }
        case 4: { for n: stock_score_4 { append_score_note(p,n); } }
        case 5: { for n: stock_score_5 { append_score_note(p,n); } }
        case 6: { for n: stock_score_6 { append_score_note(p,n); } }
        case 7: { for n: stock_score_7 { append_score_note(p,n); } }
        case 8: { for n: stock_score_8 { append_score_note(p,n); } }
        case 9: { for n: stock_score_9 { append_score_note(p,n); } }
        case 10: { for n: stock_score_10 { append_score_note(p,n); } }
        case 11: { for n: stock_score_11 { append_score_note(p,n); } }
    }
}
append_score_note :: proc(p: Player,n: Stock_Score_Note) {
    if n.tier>p.difficulty { return; }
    before:=p.notes.count;
    append_runtime_note(p,.{beat=n.beat,lane=n.lane,side=n.side,hold=n.hold});
    for i: before..<p.notes.count {
        note:=p.notes[i]; note.vocal_midi=n.midi;
        note.voice_clip=`sfx/chart_vocals/{p.song}_{note.side}_{n.lane}_{n.midi}_{round(n.hold*1000).(int)}.wav`;
    }
}
